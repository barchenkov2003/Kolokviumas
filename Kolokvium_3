%% KOL3 - Household electricity anomaly detection
% Methods:
% 1. Moving Average + Z-score
% 2. One-Class SVM
% 3. MLP Autoencoder
% 4. Windowed One-Class SVM

clear;
clc;
close all;

%% 1. DATA READING

filePath = 'household_power_consumption.txt';

fprintf('Loading data...\n');

opts = detectImportOptions(filePath, ...
    'Delimiter', ';', ...
    'DecimalSeparator', '.');

T = readtable(filePath, opts);

fprintf('Initial records: %d\n', height(T));

%% 2. DATE AND TIME

dateText = string(T.Date);
timeText = string(T.Time);

T.DateTime = datetime( ...
    dateText + " " + timeText, ...
    'InputFormat', 'dd/MM/yyyy HH:mm:ss');

%% 3. MISSING VALUES

fprintf('\nProcessing missing values...\n');

featureNames = { ...
    'Global_active_power', ...
    'Global_reactive_power', ...
    'Voltage', ...
    'Global_intensity', ...
    'Sub_metering_1', ...
    'Sub_metering_2', ...
    'Sub_metering_3'};

for i = 1:length(featureNames)

    columnData = T.(featureNames{i});

    columnData = fillmissing(columnData, 'linear');
    columnData = fillmissing(columnData, 'previous');
    columnData = fillmissing(columnData, 'next');

    T.(featureNames{i}) = columnData;

end

%% 4. AGGREGATION TO 15 MINUTES

fprintf('\nAggregating data to 15-minute intervals...\n');

TT = table2timetable(T);

TT15 = retime( ...
    TT, ...
    'regular', ...
    'mean', ...
    'TimeStep', minutes(15));

fprintf('Records after aggregation: %d\n', ...
    height(TT15));

%% 5. MISSING VALUES AFTER AGGREGATION

for i = 1:length(featureNames)

    columnData = TT15.(featureNames{i});

    columnData = fillmissing(columnData, 'linear');
    columnData = fillmissing(columnData, 'previous');
    columnData = fillmissing(columnData, 'next');

    TT15.(featureNames{i}) = columnData;

end

%% 6. FEATURE CREATION

activePower = TT15.Global_active_power;
reactivePower = TT15.Global_reactive_power;
voltage = TT15.Voltage;
current = TT15.Global_intensity;

sub1 = TT15.Sub_metering_1;
sub2 = TT15.Sub_metering_2;
sub3 = TT15.Sub_metering_3;

activeStd = movstd( ...
    activePower, ...
    [3 0]);

activeChange = ...
    [0; diff(activePower)];

X = [ ...
    activePower, ...
    reactivePower, ...
    voltage, ...
    current, ...
    sub1, ...
    sub2, ...
    sub3, ...
    activeStd, ...
    activeChange];

validRows = all(isfinite(X), 2);

X = X(validRows,:);

fprintf('Final data amount: %d\n', ...
    size(X,1));

%% 7. CHRONOLOGICAL DATA SPLIT

N = size(X,1);

N_train = floor(0.60 * N);

N_validation = floor(0.20 * N);

trainIdx = 1:N_train;

validationIdx = ...
    N_train + 1 : ...
    N_train + N_validation;

testIdx = ...
    N_train + N_validation + 1 : N;

X_train = X(trainIdx,:);

X_validation = X(validationIdx,:);

X_test = X(testIdx,:);

fprintf('\nData split:\n');

fprintf('Training: %d\n', ...
    size(X_train,1));

fprintf('Validation: %d\n', ...
    size(X_validation,1));

fprintf('Test: %d\n', ...
    size(X_test,1));

%% 8. ARTIFICIAL ANOMALIES

fprintf('\nGenerating artificial anomalies...\n');

X_validation_anomaly = X_validation;

X_test_anomaly = X_test;

labels_validation = ...
    zeros(size(X_validation,1),1);

labels_test = ...
    zeros(size(X_test,1),1);

anomalyLength = 4;

numValidationAnomalies = ...
    floor( ...
    0.01 * ...
    size(X_validation,1) / ...
    anomalyLength);

numTestAnomalies = ...
    floor( ...
    0.01 * ...
    size(X_test,1) / ...
    anomalyLength);

rng(42);

%% 8.1 VALIDATION ANOMALIES

usedStarts = [];

for k = 1:numValidationAnomalies

    while true

        startIdx = randi( ...
            [1, ...
            size(X_validation_anomaly,1) ...
            - anomalyLength + 1]);

        if isempty(usedStarts) || ...
                all( ...
                abs(startIdx-usedStarts) ...
                >= anomalyLength)

            break;

        end

    end

    usedStarts(end+1) = startIdx;

    idx = ...
        startIdx : ...
        startIdx + anomalyLength - 1;

    X_validation_anomaly(idx,1) = ...
        X_validation_anomaly(idx,1) * 2.5;

    labels_validation(idx) = 1;

end

%% 8.2 TEST ANOMALIES

usedStarts = [];

for k = 1:numTestAnomalies

    while true

        startIdx = randi( ...
            [1, ...
            size(X_test_anomaly,1) ...
            - anomalyLength + 1]);

        if isempty(usedStarts) || ...
                all( ...
                abs(startIdx-usedStarts) ...
                >= anomalyLength)

            break;

        end

    end

    usedStarts(end+1) = startIdx;

    idx = ...
        startIdx : ...
        startIdx + anomalyLength - 1;

    X_test_anomaly(idx,1) = ...
        X_test_anomaly(idx,1) * 2.5;

    labels_test(idx) = 1;

end

%% 8.3 RECALCULATE DEPENDENT FEATURES

X_validation_anomaly(:,8) = ...
    movstd( ...
    X_validation_anomaly(:,1), ...
    [3 0]);

X_validation_anomaly(:,9) = ...
    [0; ...
    diff(X_validation_anomaly(:,1))];

X_test_anomaly(:,8) = ...
    movstd( ...
    X_test_anomaly(:,1), ...
    [3 0]);

X_test_anomaly(:,9) = ...
    [0; ...
    diff(X_test_anomaly(:,1))];

fprintf( ...
    'Validation anomalies: %d\n', ...
    sum(labels_validation));

fprintf( ...
    'Test anomalies: %d\n', ...
    sum(labels_test));

%% 9. BASELINE
% Moving Average + Z-score

fprintf('\n========================================\n');
fprintf('BASELINE\n');
fprintf('Moving Average + Z-score\n');
fprintf('========================================\n');

windowSize = 16;

baselineTrainMean = ...
    movmean( ...
    X_train(:,1), ...
    [windowSize 0]);

baselineTrainResidual = ...
    X_train(:,1) - ...
    baselineTrainMean;

baselineResidualStd = ...
    std(baselineTrainResidual);

if baselineResidualStd == 0 || ...
        ~isfinite(baselineResidualStd)

    baselineResidualStd = 1;

end

validationMovingMean = ...
    movmean( ...
    X_validation_anomaly(:,1), ...
    [windowSize 0]);

validationResidual = ...
    X_validation_anomaly(:,1) - ...
    validationMovingMean;

validationZ = ...
    abs(validationResidual) / ...
    baselineResidualStd;

testMovingMean = ...
    movmean( ...
    X_test_anomaly(:,1), ...
    [windowSize 0]);

testResidual = ...
    X_test_anomaly(:,1) - ...
    testMovingMean;

testZ = ...
    abs(testResidual) / ...
    baselineResidualStd;

%% 9.1 BASELINE THRESHOLD

candidateThresholds = ...
    linspace(1,5,200);

bestThreshold = NaN;

bestScore = -inf;

for i = 1:length(candidateThresholds)

    currentThreshold = ...
        candidateThresholds(i);

    metrics = calculateMetrics( ...
        validationZ, ...
        labels_validation, ...
        currentThreshold);

    if metrics.WarningsPerDay <= 5

        if metrics.Recall > bestScore

            bestScore = ...
                metrics.Recall;

            bestThreshold = ...
                currentThreshold;

        end

    end

end

if isnan(bestThreshold)

    bestThreshold = 3;

end

baselineThreshold = bestThreshold;

baselineResult = ...
    calculateMetrics( ...
    testZ, ...
    labels_test, ...
    baselineThreshold);

fprintf( ...
    'Threshold = %.4f\n', ...
    baselineThreshold);

fprintf( ...
    'Recall = %.4f\n', ...
    baselineResult.Recall);

fprintf( ...
    'Warnings/day = %.2f\n', ...
    baselineResult.WarningsPerDay);

%% 10. STANDARDIZATION

meanTrain = ...
    mean(X_train,1);

stdTrain = ...
    std(X_train,[],1);

stdTrain(stdTrain == 0) = 1;

meanTrain(~isfinite(meanTrain)) = 0;

stdTrain(~isfinite(stdTrain)) = 1;

X_train_s = ...
    (X_train - meanTrain) ./ ...
    stdTrain;

X_validation_s = ...
    (X_validation_anomaly - meanTrain) ./ ...
    stdTrain;

X_test_s = ...
    (X_test_anomaly - meanTrain) ./ ...
    stdTrain;

if any(~isfinite(X_train_s(:))) || ...
        any(~isfinite(X_validation_s(:))) || ...
        any(~isfinite(X_test_s(:)))

    error( ...
        'Standardized data contains NaN or Inf.');

end

fprintf('\nStandardization completed.\n');

%% 11. ONE-CLASS SVM

fprintf('\n========================================\n');
fprintf('ONE-CLASS SVM\n');
fprintf('========================================\n');

maxSVMTrain = 30000;

rng(42);

if size(X_train_s,1) > maxSVMTrain

    svmIdx = ...
        randperm( ...
        size(X_train_s,1), ...
        maxSVMTrain);

    X_svm_train = ...
        X_train_s(svmIdx,:);

else

    X_svm_train = X_train_s;

end

fprintf( ...
    'SVM training records: %d\n', ...
    size(X_svm_train,1));

svmModel = fitcsvm( ...
    X_svm_train, ...
    ones(size(X_svm_train,1),1), ...
    'KernelFunction','rbf', ...
    'KernelScale','auto', ...
    'OutlierFraction',0.01, ...
    'Standardize',false);

fprintf('SVM training completed.\n');

%% 11.1 SVM VALIDATION

[~,svmValidationScore] = ...
    predict( ...
    svmModel, ...
    X_validation_s);

svmValidationScore = ...
    -svmValidationScore;

%% 11.2 SVM TEST

[~,svmTestScore] = ...
    predict( ...
    svmModel, ...
    X_test_s);

svmTestScore = ...
    -svmTestScore;

%% 11.3 SVM THRESHOLD

candidateThresholds = ...
    linspace( ...
    min(svmValidationScore), ...
    max(svmValidationScore), ...
    200);

bestThreshold = NaN;

bestScore = -inf;

for i = 1:length(candidateThresholds)

    currentThreshold = ...
        candidateThresholds(i);

    metrics = calculateMetrics( ...
        svmValidationScore, ...
        labels_validation, ...
        currentThreshold);

    if metrics.WarningsPerDay <= 5

        if metrics.Recall > bestScore

            bestScore = ...
                metrics.Recall;

            bestThreshold = ...
                currentThreshold;

        end

    end

end

if isnan(bestThreshold)

    bestThreshold = ...
        prctile( ...
        svmValidationScore,99);

end

svmThreshold = bestThreshold;

svmResult = ...
    calculateMetrics( ...
    svmTestScore, ...
    labels_test, ...
    svmThreshold);

fprintf( ...
    'Threshold = %.4f\n', ...
    svmThreshold);

fprintf( ...
    'Recall = %.4f\n', ...
    svmResult.Recall);

fprintf( ...
    'Warnings/day = %.2f\n', ...
    svmResult.WarningsPerDay);

%% 12. MLP AUTOENCODER

fprintf('\n========================================\n');
fprintf('MLP AUTOENCODER\n');
fprintf('========================================\n');

fprintf('Architecture: 9-8-3-8-9\n');

inputSize = 9;

hidden1Size = 8;

hidden2Size = 3;

hidden3Size = 8;

rng(42);

W1 = ...
    randn(inputSize,hidden1Size) * 0.1;

b1 = zeros(1,hidden1Size);

W2 = ...
    randn(hidden1Size,hidden2Size) * 0.1;

b2 = zeros(1,hidden2Size);

W3 = ...
    randn(hidden2Size,hidden3Size) * 0.1;

b3 = zeros(1,hidden3Size);

W4 = ...
    randn(hidden3Size,inputSize) * 0.1;

b4 = zeros(1,inputSize);

eta = 0.01;

iterations = 30;

fprintf( ...
    'Training iterations: %d\n', ...
    iterations);

%% 12.1 AUTOENCODER TRAINING

for iteration = 1:iterations

    totalError = 0;

    for n = 1:size(X_train_s,1)

        x = X_train_s(n,:);

        v1 = x * W1 + b1;

        y1 = ...
            1 ./ ...
            (1 + exp(-v1));

        v2 = y1 * W2 + b2;

        y2 = ...
            1 ./ ...
            (1 + exp(-v2));

        v3 = y2 * W3 + b3;

        y3 = ...
            1 ./ ...
            (1 + exp(-v3));

        y4 = y3 * W4 + b4;

        e = x - y4;

        totalError = ...
            totalError + ...
            mean(e.^2);

        delta4 = e;

        delta3 = ...
            (y3 .* (1-y3)) .* ...
            (delta4 * W4');

        delta2 = ...
            (y2 .* (1-y2)) .* ...
            (delta3 * W3');

        delta1 = ...
            (y1 .* (1-y1)) .* ...
            (delta2 * W2');

        W4 = ...
            W4 + eta * ...
            (y3' * delta4);

        b4 = ...
            b4 + eta * delta4;

        W3 = ...
            W3 + eta * ...
            (y2' * delta3);

        b3 = ...
            b3 + eta * delta3;

        W2 = ...
            W2 + eta * ...
            (y1' * delta2);

        b2 = ...
            b2 + eta * delta2;

        W1 = ...
            W1 + eta * ...
            (x' * delta1);

        b1 = ...
            b1 + eta * delta1;

    end

    totalError = ...
        totalError / ...
        size(X_train_s,1);

    fprintf( ...
        'Iteration %d/%d, error = %.6f\n', ...
        iteration, ...
        iterations, ...
        totalError);

end

%% 12.2 AUTOENCODER VALIDATION

validationAE = ...
    zeros(size(X_validation_s,1),1);

for n = 1:size(X_validation_s,1)

    x = X_validation_s(n,:);

    y1 = ...
        1 ./ ...
        (1 + exp(-(x * W1 + b1)));

    y2 = ...
        1 ./ ...
        (1 + exp(-(y1 * W2 + b2)));

    y3 = ...
        1 ./ ...
        (1 + exp(-(y2 * W3 + b3)));

    output = ...
        y3 * W4 + b4;

    validationAE(n) = ...
        mean((x-output).^2);

end

%% 12.3 AUTOENCODER TEST

testAE = ...
    zeros(size(X_test_s,1),1);

for n = 1:size(X_test_s,1)

    x = X_test_s(n,:);

    y1 = ...
        1 ./ ...
        (1 + exp(-(x * W1 + b1)));

    y2 = ...
        1 ./ ...
        (1 + exp(-(y1 * W2 + b2)));

    y3 = ...
        1 ./ ...
        (1 + exp(-(y2 * W3 + b3)));

    output = ...
        y3 * W4 + b4;

    testAE(n) = ...
        mean((x-output).^2);

end

%% 12.4 AUTOENCODER THRESHOLD

candidateThresholds = ...
    linspace( ...
    min(validationAE), ...
    max(validationAE), ...
    200);

bestThreshold = NaN;

bestScore = -inf;

for i = 1:length(candidateThresholds)

    currentThreshold = ...
        candidateThresholds(i);

    metrics = calculateMetrics( ...
        validationAE, ...
        labels_validation, ...
        currentThreshold);

    if metrics.WarningsPerDay <= 5

        if metrics.Recall > bestScore

            bestScore = ...
                metrics.Recall;

            bestThreshold = ...
                currentThreshold;

        end

    end

end

if isnan(bestThreshold)

    bestThreshold = ...
        prctile(validationAE,99);

end

aeThreshold = bestThreshold;

aeResult = ...
    calculateMetrics( ...
    testAE, ...
    labels_test, ...
    aeThreshold);

fprintf( ...
    'Threshold = %.6f\n', ...
    aeThreshold);

fprintf( ...
    'Recall = %.4f\n', ...
    aeResult.Recall);

fprintf( ...
    'Warnings/day = %.2f\n', ...
    aeResult.WarningsPerDay);

%% 13. WINDOWED ONE-CLASS SVM

fprintf('\n========================================\n');
fprintf('WINDOWED ONE-CLASS SVM\n');
fprintf('========================================\n');

windowCandidates = [1 4 8 16];

windowValidationRecall = ...
    zeros(length(windowCandidates),1);

windowValidationWarnings = ...
    zeros(length(windowCandidates),1);

bestWindow = NaN;

bestWindowScore = -inf;

bestWindowWarnings = inf;

bestWindowThreshold = NaN;

for wIdx = 1:length(windowCandidates)

    W = windowCandidates(wIdx);

    fprintf( ...
        '\nTesting window: %d intervals\n', ...
        W);

    XwTrain = ...
        createWindowSamples( ...
        X_train_s, ...
        W);

    XwValidation = ...
        createWindowSamples( ...
        X_validation_s, ...
        W);

    if size(XwTrain,1) > maxSVMTrain

        rng(42);

        idx = ...
            randperm( ...
            size(XwTrain,1), ...
            maxSVMTrain);

        XwTrainModel = ...
            XwTrain(idx,:);

    else

        XwTrainModel = XwTrain;

    end

    windowSVM = fitcsvm( ...
        XwTrainModel, ...
        ones(size(XwTrainModel,1),1), ...
        'KernelFunction','rbf', ...
        'KernelScale','auto', ...
        'OutlierFraction',0.01, ...
        'Standardize',false);

    [~,validationScore] = ...
        predict( ...
        windowSVM, ...
        XwValidation);

    validationScore = ...
        -validationScore;

    % A window is anomalous if at least
    % one interval inside it is anomalous.

    validationLabels = ...
        createWindowLabels( ...
        labels_validation, ...
        W);

    thresholdCandidates = ...
        linspace( ...
        min(validationScore), ...
        max(validationScore), ...
        150);

    localBestRecall = -inf;

    localBestThreshold = NaN;

    localBestWarnings = inf;

    for tIdx = 1:length(thresholdCandidates)

        threshold = ...
            thresholdCandidates(tIdx);

        metrics = calculateMetrics( ...
            validationScore, ...
            validationLabels, ...
            threshold);

        if metrics.WarningsPerDay <= 5

            if metrics.Recall > localBestRecall

                localBestRecall = ...
                    metrics.Recall;

                localBestThreshold = ...
                    threshold;

                localBestWarnings = ...
                    metrics.WarningsPerDay;

            end

        end

    end

    if isnan(localBestThreshold)

        localBestThreshold = ...
            prctile( ...
            validationScore,99);

        localMetrics = ...
            calculateMetrics( ...
            validationScore, ...
            validationLabels, ...
            localBestThreshold);

        localBestRecall = ...
            localMetrics.Recall;

        localBestWarnings = ...
            localMetrics.WarningsPerDay;

    end

    windowValidationRecall(wIdx) = ...
        localBestRecall;

    windowValidationWarnings(wIdx) = ...
        localBestWarnings;

    fprintf( ...
        'Validation Recall = %.4f\n', ...
        localBestRecall);

    fprintf( ...
        'Validation warnings/day = %.2f\n', ...
        localBestWarnings);

    % Maximum Recall is preferred.
    % If Recall is equal, fewer warnings are preferred.

    if localBestRecall > bestWindowScore || ...
            (localBestRecall == bestWindowScore && ...
            localBestWarnings < bestWindowWarnings)

        bestWindowScore = ...
            localBestRecall;

        bestWindow = W;

        bestWindowWarnings = ...
            localBestWarnings;

        bestWindowThreshold = ...
            localBestThreshold;

    end

end

fprintf( ...
    '\nSelected window: %d intervals\n', ...
    bestWindow);

fprintf( ...
    'Selected window duration: %.2f hours\n', ...
    bestWindow * 15 / 60);

fprintf( ...
    'Validation Recall = %.4f\n', ...
    bestWindowScore);

fprintf( ...
    'Validation warnings/day = %.2f\n', ...
    bestWindowWarnings);

%% 13.1 FINAL WINDOWED SVM TEST

XwTrain = ...
    createWindowSamples( ...
    X_train_s, ...
    bestWindow);

XwTest = ...
    createWindowSamples( ...
    X_test_s, ...
    bestWindow);

if size(XwTrain,1) > maxSVMTrain

    rng(42);

    idx = ...
        randperm( ...
        size(XwTrain,1), ...
        maxSVMTrain);

    XwTrainModel = ...
        XwTrain(idx,:);

else

    XwTrainModel = XwTrain;

end

windowSVMFinal = fitcsvm( ...
    XwTrainModel, ...
    ones(size(XwTrainModel,1),1), ...
    'KernelFunction','rbf', ...
    'KernelScale','auto', ...
    'OutlierFraction',0.01, ...
    'Standardize',false);

[~,windowTestScore] = ...
    predict( ...
    windowSVMFinal, ...
    XwTest);

windowTestScore = ...
    -windowTestScore;

windowTestLabels = ...
    createWindowLabels( ...
    labels_test, ...
    bestWindow);

windowResult = ...
    calculateMetrics( ...
    windowTestScore, ...
    windowTestLabels, ...
    bestWindowThreshold);

fprintf('\nFINAL WINDOWED SVM TEST\n');

fprintf( ...
    'Window = %d intervals\n', ...
    bestWindow);

fprintf( ...
    'Window duration = %.2f hours\n', ...
    bestWindow * 15 / 60);

fprintf( ...
    'Recall = %.4f\n', ...
    windowResult.Recall);

fprintf( ...
    'Warnings/day = %.2f\n', ...
    windowResult.WarningsPerDay);

%% 14. FINAL RESULTS

fprintf('\n========================================\n');
fprintf('FINAL RESULTS\n');
fprintf('========================================\n');

Method = { ...
    'Moving Average + Z-score'; ...
    'One-Class SVM'; ...
    'MLP Autoencoder'; ...
    'Windowed One-Class SVM'};

Recall = [ ...
    baselineResult.Recall; ...
    svmResult.Recall; ...
    aeResult.Recall; ...
    windowResult.Recall];

WarningsPerDay = [ ...
    baselineResult.WarningsPerDay; ...
    svmResult.WarningsPerDay; ...
    aeResult.WarningsPerDay; ...
    windowResult.WarningsPerDay];

Stability = [ ...
    baselineResult.Stability; ...
    svmResult.Stability; ...
    aeResult.Stability; ...
    windowResult.Stability];

resultsTable = table( ...
    Method, ...
    Recall, ...
    WarningsPerDay, ...
    Stability);

disp(resultsTable);

writetable( ...
    resultsTable, ...
    'rezultatai_kol3.csv');

%% 15. WINDOW PARAMETER RESULTS

tuningTable = table( ...
    windowCandidates', ...
    windowValidationRecall, ...
    windowValidationWarnings, ...
    'VariableNames', ...
    {'WindowSize', ...
    'ValidationRecall', ...
    'ValidationWarningsPerDay'});

disp(tuningTable);

writetable( ...
    tuningTable, ...
    'derinimas_kol3.csv');

%% 16. ABLATION

fprintf('\n========================================\n');
fprintf('ABLATION\n');
fprintf('========================================\n');

X_train_one = ...
    X_train(:,1);

X_validation_one = ...
    X_validation_anomaly(:,1);

X_test_one = ...
    X_test_anomaly(:,1);

oneMean = ...
    mean(X_train_one);

oneStd = ...
    std(X_train_one);

if oneStd == 0 || ~isfinite(oneStd)

    oneStd = 1;

end

X_train_one_s = ...
    (X_train_one-oneMean) / oneStd;

X_validation_one_s = ...
    (X_validation_one-oneMean) / oneStd;

X_test_one_s = ...
    (X_test_one-oneMean) / oneStd;

rng(42);

if size(X_train_one_s,1) > maxSVMTrain

    svmIdx = ...
        randperm( ...
        size(X_train_one_s,1), ...
        maxSVMTrain);

    X_one_train = ...
        X_train_one_s(svmIdx);

else

    X_one_train = ...
        X_train_one_s;

end

svmOneFeature = fitcsvm( ...
    X_one_train, ...
    ones(size(X_one_train,1),1), ...
    'KernelFunction','rbf', ...
    'KernelScale','auto', ...
    'OutlierFraction',0.01, ...
    'Standardize',false);

[~,oneValidationScore] = ...
    predict( ...
    svmOneFeature, ...
    X_validation_one_s);

oneValidationScore = ...
    -oneValidationScore;

[~,oneTestScore] = ...
    predict( ...
    svmOneFeature, ...
    X_test_one_s);

oneTestScore = ...
    -oneTestScore;

candidateThresholds = ...
    linspace( ...
    min(oneValidationScore), ...
    max(oneValidationScore), ...
    200);

bestThreshold = NaN;

bestScore = -inf;

for i = 1:length(candidateThresholds)

    currentThreshold = ...
        candidateThresholds(i);

    metrics = calculateMetrics( ...
        oneValidationScore, ...
        labels_validation, ...
        currentThreshold);


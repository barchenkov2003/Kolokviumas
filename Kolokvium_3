%% KOL3 - Household electricity anomaly detection
% Methods:
% 1. Moving Average + Z-score
% 2. One-Class SVM
% 3. MLP Autoencoder
% 4. Windowed One-Class SVM

clear;
clc;
close all;

%% 1. DATA READING

filePath = 'household_power_consumption.txt';

fprintf('Loading data...\n');

opts = detectImportOptions(filePath, ...
    'Delimiter',';', ...
    'DecimalSeparator','.');

T = readtable(filePath,opts);

fprintf('Initial records: %d\n',height(T));

%% 2. DATE AND TIME

dateText = string(T.Date);
timeText = string(T.Time);

T.DateTime = datetime( ...
    dateText + " " + timeText, ...
    'InputFormat','dd/MM/yyyy HH:mm:ss');

%% 3. MISSING VALUES

fprintf('\nProcessing missing values...\n');

featureNames = { ...
    'Global_active_power', ...
    'Global_reactive_power', ...
    'Voltage', ...
    'Global_intensity', ...
    'Sub_metering_1', ...
    'Sub_metering_2', ...
    'Sub_metering_3'};

for i = 1:length(featureNames)

    data = T.(featureNames{i});

    data = fillmissing(data,'linear');
    data = fillmissing(data,'previous');
    data = fillmissing(data,'next');

    T.(featureNames{i}) = data;

end

%% 4. AGGREGATION TO 15 MINUTES

fprintf('\nAggregating data to 15-minute intervals...\n');

TT = table2timetable(T);

TT15 = retime( ...
    TT, ...
    'regular', ...
    'mean', ...
    'TimeStep',minutes(15));

fprintf('Records after aggregation: %d\n', ...
    height(TT15));

%% 5. MISSING VALUES AFTER AGGREGATION

for i = 1:length(featureNames)

    data = TT15.(featureNames{i});

    data = fillmissing(data,'linear');
    data = fillmissing(data,'previous');
    data = fillmissing(data,'next');

    TT15.(featureNames{i}) = data;

end

%% 6. FEATURE CREATION

activePower = TT15.Global_active_power;
reactivePower = TT15.Global_reactive_power;
voltage = TT15.Voltage;
current = TT15.Global_intensity;

sub1 = TT15.Sub_metering_1;
sub2 = TT15.Sub_metering_2;
sub3 = TT15.Sub_metering_3;

activeStd = movstd( ...
    activePower,[3 0]);

activeChange = ...
    [0;diff(activePower)];

X = [ ...
    activePower, ...
    reactivePower, ...
    voltage, ...
    current, ...
    sub1, ...
    sub2, ...
    sub3, ...
    activeStd, ...
    activeChange];

validRows = all(isfinite(X),2);

X = X(validRows,:);

fprintf('Final data amount: %d\n',size(X,1));

%% 7. CHRONOLOGICAL DATA SPLIT

N = size(X,1);

N_train = floor(0.60*N);

N_validation = floor(0.20*N);

trainIdx = 1:N_train;

validationIdx = ...
    N_train+1 : ...
    N_train+N_validation;

testIdx = ...
    N_train+N_validation+1 : N;

X_train = X(trainIdx,:);

X_validation = X(validationIdx,:);

X_test = X(testIdx,:);

fprintf('\nData split:\n');

fprintf('Training: %d\n',size(X_train,1));

fprintf('Validation: %d\n',size(X_validation,1));

fprintf('Test: %d\n',size(X_test,1));

%% 8. ARTIFICIAL ANOMALIES

fprintf('\nGenerating artificial anomalies...\n');

X_validation_anomaly = X_validation;

X_test_anomaly = X_test;

labels_validation = ...
    zeros(size(X_validation,1),1);

labels_test = ...
    zeros(size(X_test,1),1);

anomalyLength = 4;

numValidationAnomalies = ...
    floor(0.01 * ...
    size(X_validation,1) / ...
    anomalyLength);

numTestAnomalies = ...
    floor(0.01 * ...
    size(X_test,1) / ...
    anomalyLength);

rng(42);

%% 8.1 VALIDATION ANOMALIES

usedStarts = [];

for k = 1:numValidationAnomalies

    while true

        startIdx = randi( ...
            [1,...
            size(X_validation_anomaly,1) ...
            - anomalyLength + 1]);

        if isempty(usedStarts) || ...
                all(abs(startIdx-usedStarts) ...
                >= anomalyLength)

            break;

        end

    end

    usedStarts(end+1) = startIdx;

    idx = ...
        startIdx : ...
        startIdx+anomalyLength-1;

    X_validation_anomaly(idx,1) = ...
        X_validation_anomaly(idx,1)*2.5;

    labels_validation(idx) = 1;

end

%% 8.2 TEST ANOMALIES

usedStarts = [];

for k = 1:numTestAnomalies

    while true

        startIdx = randi( ...
            [1,...
            size(X_test_anomaly,1) ...
            - anomalyLength + 1]);

        if isempty(usedStarts) || ...
                all(abs(startIdx-usedStarts) ...
                >= anomalyLength)

            break;

        end

    end

    usedStarts(end+1) = startIdx;

    idx = ...
        startIdx : ...
        startIdx+anomalyLength-1;

    X_test_anomaly(idx,1) = ...
        X_test_anomaly(idx,1)*2.5;

    labels_test(idx) = 1;

end

%% 8.3 RECALCULATE DEPENDENT FEATURES

X_validation_anomaly(:,8) = ...
    movstd( ...
    X_validation_anomaly(:,1), ...
    [3 0]);

X_validation_anomaly(:,9) = ...
    [0;diff(X_validation_anomaly(:,1))];

X_test_anomaly(:,8) = ...
    movstd( ...
    X_test_anomaly(:,1), ...
    [3 0]);

X_test_anomaly(:,9) = ...
    [0;diff(X_test_anomaly(:,1))];

fprintf('Validation anomalies: %d\n', ...
    sum(labels_validation));

fprintf('Test anomalies: %d\n', ...
    sum(labels_test));

%% 9. BASELINE
% Moving Average + Z-score

fprintf('\n========================================\n');
fprintf('BASELINE\n');
fprintf('Moving Average + Z-score\n');
fprintf('========================================\n');

baselineWindow = 16;

baselineTrainMean = ...
    movmean( ...
    X_train(:,1), ...
    [baselineWindow 0]);

baselineTrainResidual = ...
    X_train(:,1) - baselineTrainMean;

baselineResidualStd = ...
    std(baselineTrainResidual);

if baselineResidualStd == 0 || ...
        ~isfinite(baselineResidualStd)

    baselineResidualStd = 1;

end

validationMovingMean = ...
    movmean( ...
    X_validation_anomaly(:,1), ...
    [baselineWindow 0]);

validationResidual = ...
    X_validation_anomaly(:,1) ...
    - validationMovingMean;

validationZ = ...
    abs(validationResidual) ...
    / baselineResidualStd;

testMovingMean = ...
    movmean( ...
    X_test_anomaly(:,1), ...
    [baselineWindow 0]);

testResidual = ...
    X_test_anomaly(:,1) ...
    - testMovingMean;

testZ = ...
    abs(testResidual) ...
    / baselineResidualStd;

%% 9.1 BASELINE THRESHOLD

candidateThresholds = ...
    linspace(1,5,200);

bestThreshold = NaN;

bestScore = -inf;

for i = 1:length(candidateThresholds)

    threshold = candidateThresholds(i);

    metrics = calculateMetrics( ...
        validationZ, ...
        labels_validation, ...
        threshold);

    if metrics.WarningsPerDay <= 5

        if metrics.Recall > bestScore

            bestScore = metrics.Recall;

            bestThreshold = threshold;

        end

    end

end

if isnan(bestThreshold)

    bestThreshold = 3;

end

baselineThreshold = bestThreshold;

baselineResult = ...
    calculateMetrics( ...
    testZ, ...
    labels_test, ...
    baselineThreshold);

fprintf('Threshold = %.4f\n', ...
    baselineThreshold);

fprintf('Recall = %.4f\n', ...
    baselineResult.Recall);

fprintf('Warnings/day = %.2f\n', ...
    baselineResult.WarningsPerDay);

%% 10. STANDARDIZATION

meanTrain = mean(X_train,1);

stdTrain = std(X_train,[],1);

stdTrain(stdTrain == 0) = 1;

meanTrain(~isfinite(meanTrain)) = 0;

stdTrain(~isfinite(stdTrain)) = 1;

X_train_s = ...
    (X_train-meanTrain)./stdTrain;

X_validation_s = ...
    (X_validation_anomaly-meanTrain)./stdTrain;

X_test_s = ...
    (X_test_anomaly-meanTrain)./stdTrain;

if any(~isfinite(X_train_s(:))) || ...
        any(~isfinite(X_validation_s(:))) || ...
        any(~isfinite(X_test_s(:)))

    error('Standardized data contains NaN or Inf.');

end

fprintf('\nStandardization completed.\n');

%% 11. ONE-CLASS SVM

fprintf('\n========================================\n');
fprintf('ONE-CLASS SVM\n');
fprintf('========================================\n');

maxSVMTrain = 30000;

rng(42);

if size(X_train_s,1) > maxSVMTrain

    svmIdx = randperm( ...
        size(X_train_s,1), ...
        maxSVMTrain);

    X_svm_train = ...
        X_train_s(svmIdx,:);

else

    X_svm_train = X_train_s;

end

fprintf('SVM training records: %d\n', ...
    size(X_svm_train,1));

svmModel = fitcsvm( ...
    X_svm_train, ...
    ones(size(X_svm_train,1),1), ...
    'KernelFunction','rbf', ...
    'KernelScale','auto', ...
    'OutlierFraction',0.01, ...
    'Standardize',false);

fprintf('SVM training completed.\n');

%% 11.1 SVM VALIDATION

[~,svmValidationScore] = ...
    predict( ...
    svmModel, ...
    X_validation_s);

svmValidationScore = ...
    -svmValidationScore;

%% 11.2 SVM TEST

[~,svmTestScore] = ...
    predict( ...
    svmModel, ...
    X_test_s);

svmTestScore = ...
    -svmTestScore;

%% 11.3 SVM THRESHOLD

candidateThresholds = ...
    linspace( ...
    min(svmValidationScore), ...
    max(svmValidationScore), ...
    200);

bestThreshold = NaN;

bestScore = -inf;

for i = 1:length(candidateThresholds)

    threshold = candidateThresholds(i);

    metrics = calculateMetrics( ...
        svmValidationScore, ...
        labels_validation, ...
        threshold);

    if metrics.WarningsPerDay <= 5

        if metrics.Recall > bestScore

            bestScore = metrics.Recall;

            bestThreshold = threshold;

        end

    end

end

if isnan(bestThreshold)

    bestThreshold = ...
        prctile(svmValidationScore,99);

end

svmThreshold = bestThreshold;

svmResult = ...
    calculateMetrics( ...
    svmTestScore, ...
    labels_test, ...
    svmThreshold);

fprintf('Threshold = %.4f\n', ...
    svmThreshold);

fprintf('Recall = %.4f\n', ...
    svmResult.Recall);

fprintf('Warnings/day = %.2f\n', ...
    svmResult.WarningsPerDay);

%% 12. MLP AUTOENCODER

fprintf('\n========================================\n');
fprintf('MLP AUTOENCODER\n');
fprintf('========================================\n');

fprintf('Architecture: 9-8-3-8-9\n');

inputSize = 9;

hidden1Size = 8;

hidden2Size = 3;

hidden3Size = 8;

rng(42);

W1 = randn(inputSize,hidden1Size)*0.1;
b1 = zeros(1,hidden1Size);

W2 = randn(hidden1Size,hidden2Size)*0.1;
b2 = zeros(1,hidden2Size);

W3 = randn(hidden2Size,hidden3Size)*0.1;
b3 = zeros(1,hidden3Size);

W4 = randn(hidden3Size,inputSize)*0.1;
b4 = zeros(1,inputSize);

eta = 0.01;

iterations = 30;

fprintf('Training iterations: %d\n',iterations);

%% 12.1 AUTOENCODER TRAINING

for iteration = 1:iterations

    totalError = 0;

    for n = 1:size(X_train_s,1)

        x = X_train_s(n,:);

        v1 = x*W1+b1;

        y1 = 1./(1+exp(-v1));

        v2 = y1*W2+b2;

        y2 = 1./(1+exp(-v2));

        v3 = y2*W3+b3;

        y3 = 1./(1+exp(-v3));

        y4 = y3*W4+b4;

        e = x-y4;

        totalError = ...
            totalError+mean(e.^2);

        delta4 = e;

        delta3 = ...
            (y3.*(1-y3)).*(delta4*W4');

        delta2 = ...
            (y2.*(1-y2)).*(delta3*W3');

        delta1 = ...
            (y1.*(1-y1)).*(delta2*W2');

        W4 = W4+eta*(y3'*delta4);
        b4 = b4+eta*delta4;

        W3 = W3+eta*(y2'*delta3);
        b3 = b3+eta*delta3;

        W2 = W2+eta*(y1'*delta2);
        b2 = b2+eta*delta2;

        W1 = W1+eta*(x'*delta1);
        b1 = b1+eta*delta1;

    end

    totalError = ...
        totalError/size(X_train_s,1);

    fprintf( ...
        'Iteration %d/%d, error = %.6f\n', ...
        iteration, ...
        iterations, ...
        totalError);

end

%% 12.2 AUTOENCODER VALIDATION

validationAE = ...
    zeros(size(X_validation_s,1),1);

for n = 1:size(X_validation_s,1)

    x = X_validation_s(n,:);

    y1 = ...
        1./(1+exp(-(x*W1+b1)));

    y2 = ...
        1./(1+exp(-(y1*W2+b2)));

    y3 = ...
        1./(1+exp(-(y2*W3+b3)));

    output = y3*W4+b4;

    validationAE(n) = ...
        mean((x-output).^2);

end

%% 12.3 AUTOENCODER TEST

testAE = ...
    zeros(size(X_test_s,1),1);

for n = 1:size(X_test_s,1)

    x = X_test_s(n,:);

    y1 = ...
        1./(1+exp(-(x*W1+b1)));

    y2 = ...
        1./(1+exp(-(y1*W2+b2)));

    y3 = ...
        1./(1+exp(-(y2*W3+b3)));

    output = y3*W4+b4;

    testAE(n) = ...
        mean((x-output).^2);

end

%% 12.4 AUTOENCODER THRESHOLD

candidateThresholds = ...
    linspace( ...
    min(validationAE), ...
    max(validationAE), ...
    200);

bestThreshold = NaN;

bestScore = -inf;

for i = 1:length(candidateThresholds)

    threshold = candidateThresholds(i);

    metrics = calculateMetrics( ...
        validationAE, ...
        labels_validation, ...
        threshold);

    if metrics.WarningsPerDay <= 5

        if metrics.Recall > bestScore

            bestScore = metrics.Recall;

            bestThreshold = threshold;

        end

    end

end

if isnan(bestThreshold)

    bestThreshold = prctile(validationAE,99);

end

aeThreshold = bestThreshold;

aeResult = ...
    calculateMetrics( ...
    testAE, ...
    labels_test, ...
    aeThreshold);

fprintf('Threshold = %.6f\n',aeThreshold);

fprintf('Recall = %.4f\n',aeResult.Recall);

fprintf('Warnings/day = %.2f\n', ...
    aeResult.WarningsPerDay);

%% 13. WINDOWED ONE-CLASS SVM

fprintf('\n========================================\n');
fprintf('WINDOWED ONE-CLASS SVM\n');
fprintf('========================================\n');

windowCandidates = [1 4 8 16];

windowValidationRecall = ...
    zeros(length(windowCandidates),1);

windowValidationWarnings = ...
    zeros(length(windowCandidates),1);

bestWindow = NaN;

bestWindowScore = -inf;

bestWindowWarnings = inf;

bestWindowThreshold = NaN;

for wIdx = 1:length(windowCandidates)

    W = windowCandidates(wIdx);

    fprintf('\nTesting window: %d intervals\n',W);

    XwTrain = ...
        createWindowSamples(X_train_s,W);

    XwValidation = ...
        createWindowSamples( ...
        X_validation_s,W);

    if size(XwTrain,1) > maxSVMTrain

        rng(42);

        idx = randperm( ...
            size(XwTrain,1), ...
            maxSVMTrain);

        XwTrainModel = XwTrain(idx,:);

    else

        XwTrainModel = XwTrain;

    end

    windowSVM = fitcsvm( ...
        XwTrainModel, ...
        ones(size(XwTrainModel,1),1), ...
        'KernelFunction','rbf', ...
        'KernelScale','auto', ...
        'OutlierFraction',0.01, ...
        'Standardize',false);

    [~,validationScore] = ...
        predict( ...
        windowSVM, ...
        XwValidation);

    validationScore = ...
        -validationScore;

    validationLabels = ...
        createWindowLabels( ...
        labels_validation,W);

    thresholdCandidates = ...
        linspace( ...
        min(validationScore), ...
        max(validationScore), ...
        150);

    localBestRecall = -inf;

    localBestThreshold = NaN;

    localBestWarnings = inf;

    for tIdx = 1:length(thresholdCandidates)

        threshold = ...
            thresholdCandidates(tIdx);

        metrics = calculateMetrics( ...
            validationScore, ...
            validationLabels, ...
            threshold);

        if metrics.WarningsPerDay <= 5

            if metrics.Recall > localBestRecall

                localBestRecall = ...
                    metrics.Recall;

                localBestThreshold = ...
                    threshold;

                localBestWarnings = ...
                    metrics.WarningsPerDay;

            end

        end

    end

    if isnan(localBestThreshold)

        localBestThreshold = ...
            prctile(validationScore,99);

        localMetrics = ...
            calculateMetrics( ...
            validationScore, ...
            validationLabels, ...
            localBestThreshold);

        localBestRecall = ...
            localMetrics.Recall;

        localBestWarnings = ...
            localMetrics.WarningsPerDay;

    end

    windowValidationRecall(wIdx) = ...
        localBestRecall;

    windowValidationWarnings(wIdx) = ...
        localBestWarnings;

    fprintf( ...
        'Validation Recall = %.4f\n', ...
        localBestRecall);

    fprintf( ...
        'Validation warnings/day = %.2f\n', ...
        localBestWarnings);

    if localBestRecall > bestWindowScore || ...
            (localBestRecall == bestWindowScore && ...
            localBestWarnings < bestWindowWarnings)

        bestWindowScore = ...
            localBestRecall;

        bestWindow = W;

        bestWindowWarnings = ...
            localBestWarnings;

        bestWindowThreshold = ...
            localBestThreshold;

    end

end

fprintf('\nSelected window: %d intervals\n',bestWindow);

fprintf( ...
    'Selected window duration: %.2f hours\n', ...
    bestWindow*15/60);

fprintf( ...
    'Validation Recall = %.4f\n', ...
    bestWindowScore);

fprintf( ...
    'Validation warnings/day = %.2f\n', ...
    bestWindowWarnings);

%% 13.1 FINAL WINDOWED SVM TEST

XwTrain = ...
    createWindowSamples( ...
    X_train_s,bestWindow);

XwTest = ...
    createWindowSamples( ...
    X_test_s,bestWindow);

if size(XwTrain,1) > maxSVMTrain

    rng(42);

    idx = randperm( ...
        size(XwTrain,1), ...
        maxSVMTrain);

    XwTrainModel = XwTrain(idx,:);

else

    XwTrainModel = XwTrain;

end

windowSVMFinal = fitcsvm( ...
    XwTrainModel, ...
    ones(size(XwTrainModel,1),1), ...
    'KernelFunction','rbf', ...
    'KernelScale','auto', ...
    'OutlierFraction',0.01, ...
    'Standardize',false);

[~,windowTestScore] = ...
    predict( ...
    windowSVMFinal, ...
    XwTest);

windowTestScore = ...
    -windowTestScore;

windowTestLabels = ...
    createWindowLabels( ...
    labels_test,bestWindow);

windowResult = ...
    calculateMetrics( ...
    windowTestScore, ...
    windowTestLabels, ...
    bestWindowThreshold);

fprintf('\nFINAL WINDOWED SVM TEST\n');

fprintf('Window = %d intervals\n',bestWindow);

fprintf( ...
    'Window duration = %.2f hours\n', ...
    bestWindow*15/60);

fprintf('Recall = %.4f\n', ...
    windowResult.Recall);

fprintf( ...
    'Warnings/day = %.2f\n', ...
    windowResult.WarningsPerDay);

%% 13.2 ERROR ANALYSIS
% Error analysis is performed on detection events.
% Consecutive overlapping windows are treated as one event.

fprintf('\n========================================\n');
fprintf('ERROR ANALYSIS - WINDOWED ONE-CLASS SVM\n');
fprintf('========================================\n');

windowPredictions = ...
    windowTestScore > bestWindowThreshold;

%% 13.2.1 CONVERT WINDOW PREDICTIONS TO ORIGINAL INTERVALS

detectedIntervals = ...
    false(length(labels_test),1);

detectedWindowIdx = ...
    find(windowPredictions);

for i = 1:length(detectedWindowIdx)

    startIdx = detectedWindowIdx(i);

    endIdx = ...
        min( ...
        startIdx+bestWindow-1, ...
        length(labels_test));

    detectedIntervals(startIdx:endIdx) = true;

end

%% 13.2.2 FIND TRUE ANOMALY EVENTS

trueEvents = ...
    findBinaryEvents(labels_test);

%% 13.2.3 FIND DETECTED EVENTS

detectedEvents = ...
    findBinaryEvents(detectedIntervals);

%% 13.2.4 MATCH DETECTED EVENTS TO TRUE EVENTS

trueEventCount = size(trueEvents,1);

detectedEventCount = size(detectedEvents,1);

matchedTrueEvents = false(trueEventCount,1);

matchedDetectedEvents = ...
    false(detectedEventCount,1);

for i = 1:trueEventCount

    trueStart = trueEvents(i,1);

    trueEnd = trueEvents(i,2);

    for j = 1:detectedEventCount

        detectedStart = ...
            detectedEvents(j,1);

        detectedEnd = ...
            detectedEvents(j,2);

        overlap = ...
            detectedStart <= trueEnd && ...
            detectedEnd >= trueStart;

        if overlap

            matchedTrueEvents(i) = true;

            matchedDetectedEvents(j) = true;

        end

    end

end

eventFN_idx = ...
    find(~matchedTrueEvents);

eventFP_idx = ...
    find(~matchedDetectedEvents);

eventTP = ...
    sum(matchedTrueEvents);

eventFN = ...
    length(eventFN_idx);

eventFP = ...
    length(eventFP_idx);

%% 13.2.5 EVENT-LEVEL RECALL

if trueEventCount > 0

    eventRecall = ...
        eventTP/trueEventCount;

else

    eventRecall = 0;

end

%% 13.2.6 EVENT-LEVEL FALSE POSITIVE RATE

if detectedEventCount > 0

    eventFalsePositiveRate = ...
        eventFP/detectedEventCount;

else

    eventFalsePositiveRate = 0;

end

fprintf('\nTrue anomaly events: %d\n', ...
    trueEventCount);

fprintf('Detected events: %d\n', ...
    detectedEventCount);

fprintf('Matched events: %d\n', ...
    eventTP);

fprintf('Missed anomaly events (FN): %d\n', ...
    eventFN);

fprintf('False alarm events (FP): %d\n', ...
    eventFP);

fprintf('Event-level Recall: %.4f\n', ...
    eventRecall);

fprintf( ...
    'False alarm event rate: %.4f\n', ...
    eventFalsePositiveRate);

%% 13.2.7 FALSE NEGATIVE EXAMPLES

fprintf('\n----------------------------------------\n');
fprintf('MISSED ANOMALY EVENTS\n');
fprintf('----------------------------------------\n');

numFN = min(10,length(eventFN_idx));

if numFN == 0

    fprintf( ...
        'No missed anomaly events found.\n');

else

    fprintf( ...
        'Event\tStart\tEnd\tMax power\n');

    for i = 1:numFN

        eventNumber = eventFN_idx(i);

        startIdx = ...
            trueEvents(eventNumber,1);

        endIdx = ...
            trueEvents(eventNumber,2);

        maxPower = ...
            max(X_test_anomaly( ...
            startIdx:endIdx,1));

        fprintf( ...
            '%d\t%d\t%d\t%.4f\n', ...
            eventNumber, ...
            startIdx, ...
            endIdx, ...
            maxPower);

    end

end

%% 13.2.8 FALSE POSITIVE EXAMPLES

fprintf('\n----------------------------------------\n');
fprintf('FALSE POSITIVE EVENTS\n');
fprintf('----------------------------------------\n');

numFP = min(10,length(eventFP_idx));

if numFP == 0

    fprintf( ...
        'No false positive events found.\n');

else

    fprintf( ...
        'Event\tStart\tEnd\tMax power\n');

    for i = 1:numFP

        eventNumber = eventFP_idx(i);

        startIdx = ...
            detectedEvents(eventNumber,1);

        endIdx = ...
            detectedEvents(eventNumber,2);

        maxPower = ...
            max(X_test_anomaly( ...
            startIdx:endIdx,1));

        fprintf( ...
            '%d\t%d\t%d\t%.4f\n', ...
            eventNumber, ...
            startIdx, ...
            endIdx, ...
            maxPower);

    end

end

%% 13.2.9 ERROR SUMMARY

fprintf('\n----------------------------------------\n');
fprintf('ERROR SUMMARY\n');
fprintf('----------------------------------------\n');

fprintf( ...
    'True anomaly events: %d\n', ...
    trueEventCount);

fprintf( ...
    'Detected events: %d\n', ...
    detectedEventCount);

fprintf( ...
    'Correctly detected events: %d\n', ...
    eventTP);

fprintf( ...
    'Missed events: %d\n', ...

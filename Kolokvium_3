%% FUNCTION - METRICS

function result = calculateMetrics( ...
    scores, ...
    labels, ...
    threshold)

    predicted = ...
        scores > threshold;

    TP = sum( ...
        predicted == 1 & ...
        labels == 1);

    FN = sum( ...
        predicted == 0 & ...
        labels == 1);

    if (TP + FN) == 0

        recall = 0;

    else

        recall = ...
            TP / (TP + FN);

    end

    intervalsPerDay = ...
        24 * 4;

    warningsPerDay = ...
        sum(predicted) / ...
        length(predicted) * ...
        intervalsPerDay;

    stability = ...
        1 / ...
        (1 + warningsPerDay);

    result.Recall = recall;

    result.WarningsPerDay = ...
        warningsPerDay;

    result.Stability = stability;

end

%% FUNCTION - WINDOW CREATION

function Xw = ...
    createWindowSamples( ...
    X, ...
    windowSize)

    N = ...
        size(X,1);

    numSamples = ...
        N - windowSize + 1;

    numFeatures = ...
        size(X,2);

    Xw = ...
        zeros( ...
        numSamples, ...
        windowSize * numFeatures);

    for i = 1:numSamples

        window = ...
            X( ...
            i:i+windowSize-1, :);

        Xw(i,:) = ...
            reshape( ...
            window', ...
            1, ...
            windowSize * numFeatures);

    end

end

%% FUNCTION - WINDOW LABELS

function labelsWindow = ...
    createWindowLabels( ...
    labels, ...
    windowSize)

    N = length(labels);

    numSamples = ...
        N - windowSize + 1;

    labelsWindow = ...
        zeros(numSamples,1);

    for i = 1:numSamples

        currentWindow = ...
            labels( ...
            i:i+windowSize-1);

        % A window is anomalous if at least
        % one interval contains an anomaly.

        labelsWindow(i) = ...
            any(currentWindow == 1);

    end

end
